<UserControl x:Class="SpellEditor.Sources.Emulator.WorldTableEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="5,0,5,4" Opacity="0.8"/>
            <TextBlock x:Name="RankText" TextWrapping="Wrap" Margin="5,0,5,4" Opacity="0.8" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,5,4">
            <Button x:Name="AddRowButton" Content="Add" MinWidth="90" Click="AddRow_Click"/>
            <Button x:Name="SaveButton" Content="Save Changes" MinWidth="110" Margin="5,0,0,0" Click="Save_Click"/>
            <Button x:Name="RevertButton" Content="Revert" MinWidth="80" Margin="5,0,0,0" Click="Revert_Click"/>
            <Button x:Name="ReloadButton" Content="Reload" MinWidth="80" Margin="5,0,0,0" Click="Reload_Click"/>
            <Button x:Name="CopySqlButton" Content="Copy SQL" MinWidth="90" Margin="5,0,0,0" Click="CopySql_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel" Margin="0,0,5,0"/>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="5,4,5,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
